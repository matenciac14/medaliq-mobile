{
  "expo": {
    "name": "Medaliq",
    "slug": "medaliq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medaliq",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a5f"
    },
    "description": "Tu plataforma de tracking deportivo y coaching. Registra gym, running, nutricion y progreso. Conecta con tu coach o entrena solo.",
    "primaryColor": "#1e3a5f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medaliq.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Medaliq usa la cámara para escanear el código de barras de tus alimentos y registrarlos automáticamente.",
        "NSHealthShareUsageDescription": "Medaliq importa tus entrenamientos y frecuencia cardiaca desde Apple Watch para registrar tus sesiones automaticamente y pre-rellenar tu check-in semanal.",
        "NSHealthUpdateUsageDescription": "Medaliq puede escribir datos de actividad en Apple Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.medaliq.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e3a5f",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e3a5f",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "0efb76d3-e075-4f0e-8d68-870f9d60fbf4"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "miguelatencia"
  }
}
